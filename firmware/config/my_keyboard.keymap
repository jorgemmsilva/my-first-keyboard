#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// mouse cfg override (must come before pointing.h import)
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

#define HYPER LS(LC(LA(LGUI)))

&lt {
    tapping-term-ms = <140>;
    flavor = "tap-preferred";
};

&mt {
    tapping-term-ms = <140>;
    flavor = "tap-preferred";
};

/ {
    macros {
      hyper_space: hyper_space {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <
          &macro_press &kp LSHFT &kp LCTRL &kp LALT &kp LGUI
          &macro_tap &kp SPACE
          &macro_release &kp LGUI &kp LALT &kp LCTRL &kp LSHFT
        >;
      };
    };

    behaviors {
      lt_slow: lt_slow {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "tap-preferred";
        tapping-term-ms = <220>;
        quick-tap-ms = <0>;
        require-prior-idle-ms = <0>;

        bindings = <&mo>, <&kp>;
      };

      mt_slow: mt_slow {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "balanced";
        tapping-term-ms = <220>;
        quick-tap-ms = <0>;
        require-prior-idle-ms = <0>;

        bindings = <&kp>, <&kp>;
      };

      mt_mouse: mt_mouse {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_MOUSE";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;

        bindings = <&kp>, <&mkp>;
      };


    };

    combos {
        compatible = "zmk,combos";

        // ESC on fd 
        combo_esc {
            timeout-ms = <50>;
            key-positions = <15 16>;
            layers = <0>;
            bindings = <&kp ESC>;
        };

        // HYPER+SPACE on jk
        combo_hyperspace {
            timeout-ms = <50>;
            key-positions = <19 20>;
            layers = <0>;
            bindings = <&hyper_space>;
        };

        // BKSP on yu
        /* combo_bksp { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <6 7>; */
        /*     layers = <0>; */
        /*     bindings = <&kp BKSP>; */
        /* }; */
        
        // DEL on rt
        combo_del {
            timeout-ms = <50>;
            key-positions = <4 5>;
            layers = <0>;
            bindings = <&kp DEL>;
        };

        // ! on qw
        combo_exclamation {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <0>;
            bindings = <&kp EXCLAMATION>;
        };


        /* // - on ui */
        /* combo_minus { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <7 8>; */
        /*     layers = <0>; */
        /*     bindings = <&kp MINUS>; */
        /* }; */

        // + on io
        /* combo_plus { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <8 9>; */
        /*     layers = <0>; */
        /*     bindings = <&kp PLUS>; */
        /* }; */

        // = on l'
        /* combo_eq { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <21 22>; */
        /*     layers = <0>; */
        /*     bindings = <&kp EQUAL>; */
        /* }; */


        // &| on sd / xc
        combo_amp {
            timeout-ms = <50>;
            key-positions = <14 15>;
            layers = <0>;
            bindings = <&kp AMPERSAND>;
        };
        combo_pipe {
            timeout-ms = <50>;
            key-positions = <26 27>;
            layers = <0>;
            bindings = <&kp PIPE>;
        };


        // {} on fg / hj
        /* combo_lbrace { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <16 17>; */
        /*     layers = <0>; */
        /*     bindings = <&kp LEFT_BRACE>; */
        /* }; */
        /* combo_rbrace { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <18 19>; */
        /*     layers = <0>; */
        /*     bindings = <&kp RIGHT_BRACE>; */
        /* }; */


        // [] on vb / nm
        /* combo_lbracket { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <28 29>; */
        /*     layers = <0>; */
        /*     bindings = <&kp LEFT_BRACKET>; */
        /* }; */
        /* combo_rbracket { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <30 31>; */
        /*     layers = <0>; */
        /*     bindings = <&kp RIGHT_BRACKET>; */
        /* }; */

    };

    keymap {
        compatible = "zmk,keymap";


        default_layer {
            display-name = "MacOS";
            bindings = <
                &kp TAB             &kp Q       &kp W     &kp E    &kp R            &kp T           /*|*/      &kp Y   &kp U            &kp I           &kp O            &kp P                &kp BKSP
                &mt_slow HYPER ESC  &kp A       &kp S     &kp D    &kp F            &kp G           /*|*/      &kp H   &kp J            &kp K           &kp L            &kp APOSTROPHE       &kp ENTER
                &mt LSHIFT LPAR     &mt LCTRL Z &kp X     &kp C    &kp V            &kp B           /*|*/      &kp N   &kp M            &kp SEMI        &kp BACKSLASH    &mt_slow RCTRL SLASH &mt RSHIFT RPAR
                                                &kp LALT  &kp LCMD &lt_slow 4 SPACE &lt 3 GRAVE     /*|*/      &kp F12 &lt_slow 2 COMMA &lt 3 DOT  &lt_slow 4 MINUS
            >;
        };

        linux_1 {
            display-name = "Linux";
            bindings = <
                &trans &trans     &trans   &trans    &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans     &trans   &trans    &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &mt LGUI Z &trans   &trans    &trans &trans    &trans &trans &trans &trans &trans &trans
                                  &kp LALT &kp LCTRL &trans &trans    &trans &trans &trans &trans
            >;
        };

        numbers_2 {
            display-name = "Numbers";
            bindings = <
                &trans &trans &trans &trans  &trans &trans   /*|*/   &kp PLUS      &kp N7 &kp N8  &kp N9 &kp ASTERISK &trans
                &trans &trans &trans &trans  &trans &trans   /*|*/   &kp EQUAL     &kp N4 &kp N5  &kp N6 &kp PERCENT  &trans
                &trans &trans &trans &trans  &trans &trans   /*|*/   &kp MINUS     &kp N1 &kp N2  &kp N3 &kp SLASH    &trans
                              &trans &trans  &trans &trans   /*|*/   &trans        &trans &kp DOT &kp N0
            >;
        };

        nav_3 {
            display-name = "Nav";
            bindings = <
                &trans &trans  &trans &trans &kp F11 &kp F12   /*|*/  &trans        &kp END       &kp HOME  &kp LEFT_BRACKET &kp RIGHT_BRACKET &trans
                &trans &kp F1  &kp F2 &kp F3 &kp F4  &kp F5    /*|*/  &kp LEFT      &kp DOWN      &kp UP    &kp RIGHT        &kp C_VOL_UP      &trans
                &trans &kp F6  &kp F7 &kp F8 &kp F9  &kp F10   /*|*/  &kp C_PREV    &kp PG_DN     &kp PG_UP &kp C_NEXT       &kp C_VOL_DN      &trans
                               &trans &trans &trans  &trans    /*|*/  &kp LC(PG_UP) &kp LC(PG_DN) &trans    &kp C_PLAY_PAUSE
            >;

        };

        mouse_4 {
            display-name = "Mouse";
            bindings = <
                &mo 5  &kp EXCLAMATION &kp AT_SIGN         &kp HASH            &kp CARET  &kp DOLLAR       /*|*/   &trans         &mkp MB4       &mkp MB5       &trans          &trans &trans
                &trans &kp N1          &kp N2              &kp N3              &kp N4     &kp N5           /*|*/   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP   &mmv MOVE_RIGHT &kp LS(F4) &trans
                &trans &kp N6          &kp N7              &kp N8              &kp N9     &kp N0           /*|*/   &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP   &msc SCRL_RIGHT &kp F4     &trans
                                       &mt_mouse LALT MB4  &mt_mouse LCMD MB5  &trans     &trans           /*|*/   &trans         &mkp MCLK      &mkp LCLK      &mkp RCLK
            >;
        };

        /* only reacheable via layer 4*/
        system_5 {
            display-name = "System";
            bindings = <
                &none      &studio_unlock  &trans &trans &trans &sys_reset          /*|*/      &sys_reset  &trans &trans &trans &trans &to 0
                &bt BT_CLR &trans          &trans &trans &trans &trans              /*|*/      &trans      &trans &trans &trans &trans &to 1
                &bt BT_PRV &bt BT_NXT      &trans &trans &trans &trans              /*|*/      &trans      &trans &trans &trans &trans &trans
                                           &trans &trans &trans &bootloader         /*|*/      &bootloader &trans &trans &trans
            >;
        };
        
        layer_6 {
            status = "reserved";
        };

        layer_7 {
            status = "reserved";
        };
        
        layer_8 {
            status = "reserved";
        };

        layer_9 {
            status = "reserved";
        };
        
        layer_10 {
            status = "reserved";
            /* bindings = < */
            /*     &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans */
            /*     &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans */
            /*     &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans */
            /*                   &trans &trans &trans &trans    &trans &trans &trans &trans */
            /* >; */
        };
    };
};
